# نمونهٔ تنظیمات. این فایل را به نام .env کپی و مقدارها را عوض کنید.

# نشانی و پورت داخلی برنامه (nginx جلوی آن می‌نشیند)
HOST=127.0.0.1
PORT=8080

# پوشهٔ داده و پشتیبان‌ها (حتماً روی دیسک ماندگار و در برنامهٔ پشتیبان‌گیری سرور)
DATA_DIR=/var/lib/harfeno

# پشت HTTPS حتماً 1 باشد
COOKIE_SECURE=1
# پشت nginx: 1 تا IP واقعی کاربر برای محدودیت تلاش ورود خوانده شود
TRUST_PROXY=1

# نشانی سایت مدیران شهرستان؛ در متن پیام رمز برای مدیران می‌آید
PUBLIC_URL=https://bom.example.ir/

# اختیاری: اگر سایت مدیران و داشبورد روی دو دامنهٔ جدا هستند
# PUBLIC_HOST=bom.example.ir
# ADMIN_HOST=panel.example.ir

# مدت نشست‌ها
DIRECTOR_SESSION_DAYS=30
DIRECTOR_IDLE_DAYS=7
ADMIN_SESSION_HOURS=12
ADMIN_IDLE_HOURS=2

# محدودیت تلاش ناموفق ورود در هر بازه (دقیقه)
LOGIN_MAX_ATTEMPTS=8
LOGIN_WINDOW_MIN=15

# اختیاری: تحلیل خودکار با Claude از داخل داشبورد
# فقط اگر سرور به api.anthropic.com دسترسی دارد؛ وگرنه خالی بماند و از مسیر «دانلود بسته / بارگذاری خروجی» استفاده کنید.
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5-5
